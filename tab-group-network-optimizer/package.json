{
  "name": "tab-group-network-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome/Edge extension that optimizes network usage only for tabs inside tab groups.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "icons": "python3 tools/make_icons.py"
  }
}
